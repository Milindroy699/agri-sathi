---
import { useTranslations, localizedPath, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  slug: string;
  name: string;
  botanicalName: string;
  emoji: string;
  seasons: string[];
  duration: number;
}
const { locale, slug, name, botanicalName, emoji, seasons, duration } = Astro.props;
const t = useTranslations(locale);
const base = import.meta.env.BASE_URL;
const href = localizedPath(base, locale, `crops/${slug}/`);
const seasonLabel: Record<string, string> = {
  kharif: locale === 'hi' ? 'खरीफ' : 'Kharif',
  rabi: locale === 'hi' ? 'रबी' : 'Rabi',
  zaid: locale === 'hi' ? 'ज़ायद' : 'Zaid',
};
---

<a class="crop-card" href={href}>
  <span class="crop-card__emoji" aria-hidden="true">{emoji}</span>
  <span class="crop-card__body">
    <span class="crop-card__name">{name}</span>
    <span class="crop-card__latin">{botanicalName}</span>
    <span class="crop-card__meta">
      {seasons.map((s) => <span class={`chip chip--${s}`}>{seasonLabel[s] ?? s}</span>)}
      <span class="chip">{duration} {t('crop.days')}</span>
    </span>
  </span>
</a>

<style>
  .crop-card {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: var(--color-text);
  }
  .crop-card:hover { border-color: var(--color-brand); box-shadow: var(--shadow); }
  .crop-card__emoji {
    font-size: 2.25rem;
    line-height: 1;
    width: 3rem;
    text-align: center;
    flex-shrink: 0;
  }
  .crop-card__body { display: flex; flex-direction: column; gap: var(--space-1); min-width: 0; }
  .crop-card__name { font-weight: var(--weight-bold); font-size: var(--text-lg); }
  .crop-card__latin { font-size: var(--text-xs); color: var(--color-text-soft); font-style: italic; }
  .crop-card__meta { display: flex; flex-wrap: wrap; gap: var(--space-1); margin-top: var(--space-1); }
</style>
