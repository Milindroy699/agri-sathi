---
import { useTranslations, localizedPath, otherLocale, stripLocale, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const base = import.meta.env.BASE_URL;
const p = (path: string) => localizedPath(base, locale, path);

const baseNoSlash = base.replace(/\/$/, '');
const pathAfterBase = Astro.url.pathname.startsWith(baseNoSlash)
  ? Astro.url.pathname.slice(baseNoSlash.length)
  : Astro.url.pathname;
const currentPath = stripLocale(pathAfterBase);
const other = otherLocale(locale);
const otherHref = localizedPath(base, other, currentPath.replace(/^\//, ''));

const links = [
  { href: p(''), label: t('nav.home'), match: '/' },
  { href: p('my-farm/'), label: t('nav.myFarm'), match: '/my-farm' },
  { href: p('crops/'), label: t('nav.crops'), match: '/crops' },
  { href: p('tools/diagnose/'), label: t('nav.diagnose'), match: '/tools/diagnose' },
  { href: p('tools/weather/'), label: t('nav.weather'), match: '/tools/weather' },
  { href: p('tools/calendar/'), label: t('nav.calendar'), match: '/tools/calendar' },
  { href: p('tools/calculator/'), label: t('nav.calculator'), match: '/tools/calculator' },
  { href: p('glossary/'), label: t('nav.glossary'), match: '/glossary' },
  { href: p('faq/'), label: t('nav.faq'), match: '/faq' },
  { href: p('about/'), label: t('nav.about'), match: '/about' },
];

const isActive = (match: string) =>
  match === '/' ? currentPath === '/' : currentPath.startsWith(match);
---

<header class="site-header">
  <div class="site-header__bar container-wide">
    <a class="brand" href={p('')}>
      <span class="brand__mark" aria-hidden="true">🌾</span>
      <span class="brand__text">
        <strong>{t('app.name')}</strong>
        <small>{t('app.tagline')}</small>
      </span>
    </a>

    <div class="site-header__actions">
      <a class="lang-toggle" href={otherHref} rel="alternate" hreflang={other}>
        {other === 'hi' ? 'हिंदी' : 'English'}
      </a>
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primary-nav"
        aria-label={t('nav.menu')}
      >
        <span class="nav-toggle__box" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <nav id="primary-nav" class="primary-nav" aria-label={t('nav.menu')}>
    <ul class="container-wide">
      {links.map((link) => (
        <li>
          <a href={link.href} aria-current={isActive(link.match) ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-2);
    padding-inline: var(--space-4);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-text);
  }
  .brand__mark { font-size: 1.75rem; }
  .brand__text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand__text strong { font-size: var(--text-lg); color: var(--color-brand-dark); }
  .brand__text small { font-size: var(--text-xs); color: var(--color-text-soft); }

  .site-header__actions { display: flex; align-items: center; gap: var(--space-2); }

  .lang-toggle {
    min-height: var(--tap-target);
    display: inline-flex;
    align-items: center;
    padding-inline: var(--space-3);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-weight: var(--weight-medium);
    color: var(--color-brand-dark);
  }

  .nav-toggle {
    width: var(--tap-target);
    height: var(--tap-target);
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    display: inline-grid;
    place-items: center;
    cursor: pointer;
  }
  .nav-toggle__box,
  .nav-toggle__box::before,
  .nav-toggle__box::after {
    content: '';
    display: block;
    width: 20px;
    height: 2.5px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform 0.15s ease;
  }
  .nav-toggle__box { position: relative; }
  .nav-toggle__box::before { position: absolute; top: -7px; }
  .nav-toggle__box::after { position: absolute; top: 7px; }
  .nav-toggle[aria-expanded='true'] .nav-toggle__box { background: transparent; }
  .nav-toggle[aria-expanded='true'] .nav-toggle__box::before { transform: translateY(7px) rotate(45deg); }
  .nav-toggle[aria-expanded='true'] .nav-toggle__box::after { transform: translateY(-7px) rotate(-45deg); }

  .primary-nav { display: none; border-top: 1px solid var(--color-border); }
  .primary-nav.is-open { display: block; }
  .primary-nav ul {
    list-style: none;
    padding: var(--space-2) var(--space-4) var(--space-3);
    margin: 0;
  }
  .primary-nav li { margin: 0; }
  .primary-nav a {
    display: block;
    min-height: var(--tap-target);
    display: flex;
    align-items: center;
    padding-inline: var(--space-2);
    text-decoration: none;
    color: var(--color-text);
    border-radius: var(--radius-sm);
    font-weight: var(--weight-medium);
  }
  .primary-nav a[aria-current='page'] {
    color: var(--color-brand-dark);
    background: var(--color-brand-light);
  }

  @media (min-width: 52rem) {
    .nav-toggle { display: none; }
    .primary-nav { display: block; border-top: 1px solid var(--color-border); }
    .primary-nav ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1);
      padding-block: var(--space-1);
    }
    .primary-nav a { padding-inline: var(--space-3); }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('primary-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
  });
</script>
