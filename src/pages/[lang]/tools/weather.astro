---
import Base from '../../../layouts/Base.astro';
import { localePaths } from '../../../i18n/routing';
import { useTranslations, type Locale } from '../../../i18n/utils';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const checklist = [t('weather.check1'), t('weather.check2'), t('weather.check3'), t('weather.check4'), t('weather.check5')];

const strings = {
  locating: t('weather.locating'),
  gpsFailed: t('weather.gpsFailed'),
  offline: t('weather.offline'),
  noData: t('weather.noData'),
  updated: t('weather.updated'),
  today: t('weather.today'),
  forecast: t('weather.forecast'),
  rain: t('weather.rain'),
  wind: t('weather.wind'),
  tempHi: t('weather.tempHi'),
  tempLo: t('weather.tempLo'),
  spray: t('weather.spray'),
  sprayGood: t('weather.sprayGood'),
  sprayCaution: t('weather.sprayCaution'),
  sprayBad: t('weather.sprayBad'),
  whyRain: t('weather.sprayWhy.rain'),
  whyWind: t('weather.sprayWhy.wind'),
  whyHeat: t('weather.sprayWhy.heat'),
  whyOk: t('weather.sprayWhy.ok'),
  alerts: t('weather.alerts'),
  alertFrost: t('weather.alert.frost'),
  alertHeat: t('weather.alert.heat'),
  alertRain: t('weather.alert.rain'),
  alertDry: t('weather.alert.dry'),
  alertNone: t('weather.alert.none'),
  change: t('weather.change'),
  locale: locale === 'hi' ? 'hi-IN' : 'en-IN',
};
---

<Base locale={locale} title={t('weather.title')} description={t('weather.intro')}>
  <h1>{t('weather.title')}</h1>
  <p class="lead">{t('weather.intro')}</p>

  <div class="wx-loc card" data-wx-loc>
    <p class="wx-loc__title">{t('weather.setLocation')}</p>
    <div class="wx-loc__actions">
      <button type="button" class="btn" data-wx-gps>📍 {t('weather.useGps')}</button>
    </div>
    <form class="wx-manual" data-wx-manual>
      <div class="wx-manual__row">
        <label>{t('weather.lat')}<input type="number" name="lat" step="0.0001" inputmode="decimal" min="-90" max="90" required /></label>
        <label>{t('weather.lon')}<input type="number" name="lon" step="0.0001" inputmode="decimal" min="-180" max="180" required /></label>
      </div>
      <button type="submit" class="btn btn--ghost">{t('weather.save')}</button>
    </form>
    <p class="wx-msg" data-wx-msg hidden></p>
  </div>

  <div data-wx-report hidden>
    <p class="wx-meta"><span data-wx-place></span> · <span data-wx-updated></span>
      <button type="button" class="wx-change" data-wx-change>{t('weather.change')}</button>
    </p>
    <p class="wx-msg wx-msg--warn" data-wx-offline hidden>{t('weather.offline')}</p>

    <section>
      <h2>{t('weather.alerts')}</h2>
      <ul class="wx-alerts" data-wx-alerts></ul>
    </section>

    <section>
      <h2>{t('weather.forecast')}</h2>
      <ol class="wx-days" data-wx-days></ol>
    </section>
  </div>

  <section class="wx-checklist">
    <h2>{t('weather.checklist')}</h2>
    <ul>
      {checklist.map((c) => <li>{c}</li>)}
    </ul>
  </section>

  <p class="callout callout--caution mt">{t('disclaimer.text')}</p>
</Base>

<script type="application/json" id="wx-strings" set:html={JSON.stringify(strings)} />

<style>
  h1 { margin-block: var(--space-5) var(--space-2); color: var(--color-brand-dark); }
  .lead { color: var(--color-text-soft); margin-bottom: var(--space-4); }
  section { margin-block: var(--space-6); }
  section h2 { color: var(--color-brand-dark); margin-bottom: var(--space-3); }

  .wx-loc { display: grid; gap: var(--space-3); }
  .wx-loc__title { font-weight: var(--weight-bold); }
  .wx-manual { display: grid; gap: var(--space-2); }
  .wx-manual__row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); }
  .wx-manual label { display: grid; gap: var(--space-1); font-size: var(--text-sm); }
  .wx-manual input {
    min-height: var(--tap-target);
    padding-inline: var(--space-3);
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    font-size: var(--text-base);
  }
  .wx-msg { font-size: var(--text-sm); color: var(--color-text-soft); }
  .wx-msg--warn { color: var(--color-caution); font-weight: var(--weight-medium); }

  .wx-meta { font-size: var(--text-sm); color: var(--color-text-soft); display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  .wx-change { border: 2px solid var(--color-border); background: transparent; border-radius: var(--radius-pill); min-height: 36px; padding-inline: var(--space-3); cursor: pointer; }

  .wx-alerts { list-style: none; padding: 0; display: grid; gap: var(--space-2); }
  .wx-alerts li {
    padding: var(--space-3);
    border-radius: var(--radius);
    border-left: 4px solid var(--color-info);
    background: var(--color-info-bg);
    font-size: var(--text-sm);
  }
  .wx-alerts li[data-sev="frost"] { border-color: var(--color-info); background: var(--color-info-bg); }
  .wx-alerts li[data-sev="heat"] { border-color: var(--color-danger); background: var(--color-danger-bg); }
  .wx-alerts li[data-sev="rain"] { border-color: var(--color-info); background: var(--color-info-bg); }
  .wx-alerts li[data-sev="dry"] { border-color: var(--color-caution); background: var(--color-caution-bg); }
  .wx-alerts li[data-sev="none"] { border-color: var(--color-ok); background: var(--color-ok-bg); }

  .wx-days { list-style: none; padding: 0; display: grid; gap: var(--space-2); }
  .wx-day {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-2) var(--space-3);
    align-items: center;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .wx-day__date { font-weight: var(--weight-bold); }
  .wx-day__nums { font-size: var(--text-sm); color: var(--color-text-soft); }
  .wx-day__nums b { color: var(--color-text); font-weight: var(--weight-medium); }
  .wx-spray {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    padding: 4px var(--space-2);
    border-radius: var(--radius-pill);
    text-align: center;
    white-space: nowrap;
  }
  .wx-spray[data-v="good"] { background: var(--color-ok-bg); color: var(--color-ok); }
  .wx-spray[data-v="caution"] { background: var(--color-caution-bg); color: var(--color-caution); }
  .wx-spray[data-v="bad"] { background: var(--color-danger-bg); color: var(--color-danger); }
  .wx-day__why { grid-column: 1 / -1; font-size: var(--text-xs); color: var(--color-text-soft); }

  .wx-checklist ul { padding-left: 1.2rem; }
  .wx-checklist li { margin-block: var(--space-2); }
  .mt { margin-top: var(--space-6); }
</style>

<script>
  import '../../../scripts/weather';
</script>
