---
import Base from '../../layouts/Base.astro';
import CropCard from '../../components/CropCard.astro';
import CropSearch from '../../components/CropSearch.astro';
import { localePaths } from '../../i18n/routing';
import { useTranslations, localizedPath, type Locale } from '../../i18n/utils';
import { getCropIndex, getToolData } from '../../lib/content';

export const getStaticPaths = localePaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const base = import.meta.env.BASE_URL;
const p = (path: string) => localizedPath(base, locale, path);
const crops = await getCropIndex(locale);
const toolData = await getToolData(locale);

const tools = [
  { href: p('tools/diagnose/'), icon: '🔍', title: t('nav.diagnose'), text: t('diagnose.intro') },
  { href: p('tools/weather/'), icon: '🌦️', title: t('nav.weather'), text: t('weather.intro') },
  { href: p('tools/calendar/'), icon: '📅', title: t('nav.calendar'), text: t('calendar.intro') },
  { href: p('tools/calculator/'), icon: '🧮', title: t('nav.calculator'), text: t('calc.intro') },
  { href: p('glossary/'), icon: '📖', title: t('nav.glossary'), text: t('home.glossaryText') },
];

const farmStrings = {
  currentStage: t('myfarm.currentStage'),
  thisWeek: t('myfarm.thisWeek'),
  day: t('myfarm.day'),
  nothingThisWeek: t('myfarm.nothingThisWeek'),
  locale: locale === 'hi' ? 'hi-IN' : 'en-IN',
};
---

<Base locale={locale} title={t('app.name')} description={t('home.heroText')}>
  <section class="hero stack">
    <h1>{t('home.heroTitle')}</h1>
    <p class="hero__text">{t('home.heroText')}</p>
    <CropSearch locale={locale} />
    <div class="hero__cta">
      <a class="btn" href={p('crops/')}>{t('home.browseCrops')}</a>
      <a class="btn btn--ghost" href={p('tools/calendar/')}>{t('home.openCalendar')}</a>
    </div>
  </section>

  <section class="stack" data-farm-home hidden>
    <div class="farm-home__head">
      <h2>{t('myfarm.homeHeading')}</h2>
      <a href={p('my-farm/')}>{t('myfarm.homeSeeAll')} →</a>
    </div>
    <div data-farm-home-list class="farm-home__list"></div>
  </section>

  <section class="stack">
    <h2>{t('home.tools')}</h2>
    <div class="tool-grid">
      {tools.map((tool) => (
        <a class="tool-card" href={tool.href}>
          <span class="tool-card__icon" aria-hidden="true">{tool.icon}</span>
          <span class="tool-card__title">{tool.title}</span>
          <span class="tool-card__text">{tool.text}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="stack">
    <h2>{t('home.allCrops')}</h2>
    <div class="crop-grid">
      {crops.map((crop) => (
        <CropCard
          locale={locale}
          slug={crop.slug}
          name={crop.name}
          botanicalName={crop.botanicalName}
          emoji={crop.emoji}
          seasons={crop.seasons}
          duration={crop.duration}
        />
      ))}
    </div>
  </section>
</Base>

<script type="application/json" id="farm-home-crops" set:html={JSON.stringify(toolData)} />
<script type="application/json" id="farm-home-strings" set:html={JSON.stringify(farmStrings)} />

<style>
  .hero { margin-block: var(--space-5) var(--space-8); }
  .hero h1 { font-size: var(--text-2xl); color: var(--color-brand-dark); }
  .hero__text { font-size: var(--text-lg); color: var(--color-text-soft); max-width: 34ch; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  section { margin-block: var(--space-8); }

  .farm-home__head { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: baseline; justify-content: space-between; }
  .farm-home__head h2 { color: var(--color-brand-dark); }
  .farm-home__head a { font-weight: var(--weight-medium); }
  .farm-home__list { display: grid; gap: var(--space-3); }
  .farm-home__card {
    border: 1px solid var(--color-brand);
    border-radius: var(--radius);
    background: var(--color-brand-light);
    padding: var(--space-4);
  }
  .farm-home__card h3 { font-size: var(--text-lg); color: var(--color-brand-dark); }
  .farm-home__card .fh-stage { font-size: var(--text-sm); color: var(--color-text-soft); margin-block: var(--space-1); }
  .farm-home__card ul { margin: var(--space-2) 0 0; padding-left: 1.2rem; font-size: var(--text-sm); }
  .farm-home__card li { margin-block: var(--space-1); }
  .farm-home__card li.more { list-style: none; margin-left: -1.2rem; color: var(--color-text-soft); }

  .tool-grid { display: grid; gap: var(--space-3); }
  .tool-card {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--color-text);
  }
  .tool-card:hover { border-color: var(--color-brand); }
  .tool-card__icon { font-size: 2rem; }
  .tool-card__title { font-weight: var(--weight-bold); font-size: var(--text-lg); color: var(--color-brand-dark); }
  .tool-card__text { font-size: var(--text-sm); color: var(--color-text-soft); }

  .crop-grid { display: grid; gap: var(--space-3); }

  @media (min-width: 40rem) {
    .tool-grid { grid-template-columns: repeat(3, 1fr); }
    .crop-grid { grid-template-columns: repeat(2, 1fr); }
    .farm-home__list { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 60rem) {
    .crop-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>

<script>
  import '../../scripts/farm-home';
</script>
